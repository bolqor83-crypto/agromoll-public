{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@agromoll/ui": ["packages/ui/src/index.ts"],
      "@agromoll/types": ["packages/types/src/index.ts"],
      "@agromoll/validation": ["packages/validation/src/index.ts"]
    }
  }
}
