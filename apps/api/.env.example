# Порт API
API_PORT=3000
# Уровень логирования: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Должен совпадать с docker-compose.yml (репозиторий в корне)
DATABASE_URL=postgresql://agromoll:agromoll@localhost:5432/agromoll?schema=public
# TTL запроса брони в минутах (по истечении гасится кроном, резерв возвращается)
BOOKING_TTL_MINUTES=30

# ─── Аутентификация (v0.3.0, см. docs/adr/ADR-007) ────────────────────────
# Redis для SMS-кодов (TTL 5 минут). Без REDIS_URL — in-memory fallback
# только для локальной разработки; в production Redis обязателен.
REDIS_URL=redis://localhost:6379
# Секреты JWT. В production (NODE_ENV=production) отсутствие — ошибка старта.
# Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Сроки жизни токенов (формат ms/jsonwebtoken: 15m, 30d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
