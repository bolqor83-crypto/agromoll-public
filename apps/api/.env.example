# Порт API
API_PORT=3000
# Уровень логирования: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Должен совпадать с docker-compose.yml (репозиторий в корне)
DATABASE_URL=postgresql://agromoll:agromoll@localhost:5432/agromoll?schema=public
# TTL запроса брони в минутах (по истечении гасится кроном, резерв возвращается)
BOOKING_TTL_MINUTES=30

# ─── Аутентификация (v0.3.0, см. docs/adr/ADR-007) ────────────────────────
# Redis для SMS-кодов (TTL 5 минут). Без REDIS_URL — in-memory fallback
# только для локальной разработки; в production Redis обязателен.
REDIS_URL=redis://localhost:6379
# Секреты JWT. В production (NODE_ENV=production) отсутствие — ошибка старта.
# Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Сроки жизни токенов (формат ms/jsonwebtoken: 15m, 30d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Демо-режим входа (v0.8.0-C): true — SMS-код всегда «000000» (6 нулей), даже в
# production. Только для публичного демо! Боевой запуск — не выставлять
# (переменной нет или false). SMS-провайдера в MVP ещё нет (ADR-007).
AUTH_DEMO_LOGIN=

# ─── Публичный рейтинг (v0.5.0, ADR-013) ──────────────────────────────────
# Минимум учтённых событий для появления score (меньше — score=null)
RATING_MIN_DEALS=5
# Анти-накрутка: сделок пары в окне выше этого числа — вес 0.3
RATING_MAX_PAIR_DEALS=10
# Окно анти-накрутки в днях
RATING_PAIR_WINDOW_DAYS=30
# Веса: сделка ok / minor_issue / авто-подтверждение / спор / кап пары
RATING_WEIGHT_OK=1.0
RATING_WEIGHT_MINOR=0.5
RATING_WEIGHT_AUTO=0.3
RATING_WEIGHT_DISPUTE=1.0
RATING_PAIR_CAP_WEIGHT=0.3

# ─── Геозоны (v0.5.0, ADR-014) ─────────────────────────────────────────────
# Радиус nearby-поиска по умолчанию в метрах (ST_DWithin, PostGIS)
DEFAULT_GEO_RADIUS_METERS=2000

# ─── Доставка попутчиками (v0.5.0, ADR-015) ─────────────────────────────────
# TTL открытого запроса в минутах (open → expired кроном каждые 5 минут)
DELIVERY_TTL_MINUTES=60

# ─── S3-хранилище файлов (v0.7.0-B, ADR-036/038) ───────────────────────────
# Один бакет для всех файлов: доказательства споров (disputes/<id>/…)
# и фото товаров (listings/<id>/…). Любой S3-совместимый провайдер
# (AWS S3 / R2 / Yandex; локально — LocalStack из docker-compose,
# сервис s3). Пусто — fallback на data:-URL ≤ 500 КБ.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=agromoll-evidence
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
