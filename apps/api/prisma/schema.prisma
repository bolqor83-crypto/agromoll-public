// АгроМолл — схема v0.3.0 «Аутентификация по телефону» + v0.3.1 «Сессии»
// + v0.4.0 «Долги» (подэтап A).
// + v0.5.0 «Публичный рейтинг» (подэтап A, ADR-013)
// + v0.5.0 «Геозоны» (подэтап B, ADR-014)
// + v0.5.0 «Доставка попутчиками» (подэтап C, ADR-015).
// + v0.6.0 «Push-уведомления» (подэтап A, ADR-031): DeviceToken /
//   WebPushSubscription / NotificationLog; fcmToken удалён (мёртвая
//   колонка — ни один код не писал её с v0.4.0).
//
// Домен: продавец выставляет листинг (Listing), покупатель бронирует
// количество (Booking), продавец может подтвердить или предложить
// корректировку. Каждое изменение брони фиксируется в append-only журнале
// BookingEvent — из него в будущем считается репутация.
// v0.3.0: вход по телефону + SMS-код (заглушка в dev), JWT-токены —
// см. docs/adr/ADR-007.
// v0.3.1: Session — аудит-запись «семьи» refresh-токенов для ротации
// с обнаружением повторного использования (ADR-008). Источник решений
// об авторизации — Redis (см. session-store.ts), таблица — журнал.
// v0.4.0-A: Debt/DebtEvent — учёт долгов «продавец отпустил в долг»
// (ADR-010). Платформа НЕ проводит деньги: запись — только договорённость
// сторон. Notification — минимальные in-app уведомления (напоминание
// должнику). Обоснование бронирования — docs/adr/ADR-004.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Действие из журнала репутации (v0.5.0, ADR-013).
/// deal_confirmed — сделка/долг закрыты позитивно (delta = вес события);
/// dispute_opened — спор (delta отрицательный);
/// dispute_resolved — спор разрешён обоюдно (нейтрально, delta = 0);
/// auto_confirmed — авто-подтверждение приёмки (вес меньше явного);
/// penalty_applied — анти-накрутка: паре сделок назначен пониженный вес.
enum ReputationAction {
  deal_confirmed
  dispute_opened
  dispute_resolved
  auto_confirmed
  penalty_applied
}

/// Тип геозоны (v0.5.0, ADR-014).
/// buyer_point — точка покупателя (куда везти товар);
/// seller_line — линия/ряд продавца на рынке (откуда забирать);
/// delivery_corridor — коридор доставщика (куда он едет и может подвезти).
enum GeoPointKind {
  buyer_point
  seller_line
  delivery_corridor
}

/// Тип транспорта коридора доставщика (v0.5.0, ADR-014).
enum GeoVehicleType {
  car
  van
  refrigerated
  flatbed
}

/// Статус запроса доставки (v0.5.0, ADR-015).
/// open — ждёт водителя; assigned — водитель взял; in_transit — везёт;
/// delivered — передано; cancelled/expired — терминальные.
enum DeliveryStatus {
  open
  assigned
  in_transit
  delivered
  cancelled
  expired
}

/// Действие из журнала доставки (v0.5.0, ADR-015).
/// blocked_by_289fz — попытка взять заказ заблокированной парой
/// (запрос остаётся открытым для других водителей).
enum DeliveryEventAction {
  created
  assigned
  started
  delivered
  cancelled
  expired
  blocked_by_289fz
}

/// Роль участника рынка. Совпадает с USER_ROLES из @agromoll/types
/// и UserRoleSchema из @agromoll/validation.
///
/// arbitrator (v0.6.0-C, ADR-033) — арбитр рынка: рассматривает споры
/// и апелляции на блокировки 289-ФЗ. НЕ переключается через
/// PATCH /users/me/role (там только рыночные роли MARKET_ROLES):
/// арбитром назначают вручную/сидом — конфликт интересов исключён.
enum UserRole {
  buyer
  seller
  driver
  arbitrator
}

/// Категория товара. Совпадает с LISTING_CATEGORIES из @agromoll/types.
enum ListingCategory {
  vegetables
  fruits
  grocery
  snacks
  other
}

/// Единица измерения товара. Совпадает с LISTING_UNITS из @agromoll/types.
enum ListingUnit {
  kg
  box
  piece
}

/// Жизненный цикл листинга. Совпадает с LISTING_STATUSES из @agromoll/types.
enum ListingStatus {
  active
  paused
  sold_out
  archived
}

/// Статус брони. Совпадает с BOOKING_STATUSES из @agromoll/types.
/// Допустимые переходы см. в bookings.service.ts (машина состояний).
/// v0.4.0-C: completed — терминальный (приёмка подтверждена),
/// disputed — спор по качеству поставки (ADR-012).
enum BookingStatus {
  requested
  counter_offered
  confirmed
  cancelled
  expired
  completed
  disputed
}

/// Действие из журнала брони. Совпадает с BOOKING_ACTIONS из @agromoll/types.
enum BookingAction {
  created
  counter_offered
  accepted_counter
  confirmed
  cancelled
  expired
  /// Покупатель подтвердил приёмку (v0.4.0-C, ADR-012).
  delivery_confirmed
  /// Покупатель заявил серьезную проблему качества — спор (v0.4.0-C).
  delivery_disputed
  /// Система закрыла бронь авто-подтверждением через 24 ч (v0.4.0-C).
  system_auto_confirmed
}

/// Оценка качества поставки при приёмке (v0.4.0-C, ADR-012).
/// ok — всё в порядке; minor_issue — недостача/мелкие проблемы
/// (бронь всё равно завершается); major_issue — серьёзная проблема
/// (бронь уходит в спор).
enum QualityFlag {
  ok
  minor_issue
  major_issue
}

model User {
  id                 String   @id @default(uuid())
  role               UserRole @default(buyer)
  displayName        String
  /// Телефон — основной идентификатор входа (v0.3.0, ADR-007).
  /// Nullable ради старых строк: новые пользователи создаются только
  /// через /auth/request-code, где телефон обязателен и уникален.
  /// В Postgres unique-индекс допускает несколько NULL.
  phone              String?  @unique
  /// Прошёл ли подтверждение номера SMS-кодом.
  phoneVerified      Boolean  @default(false)
  /// Пароль — опциональный запасной способ входа. В MVP вход только
  /// по телефону + коду; колонка заложена на будущее (ADR-007).
  passwordHash       String?
  reputationScore    Float    @default(0)
  /// Репутационные счётчики (v0.4.0-C, ADR-012): фундамент публичного
  /// рейтинга v0.5.0; источник правды — события, счётчики — быстрый view.
  totalConfirmations Int      @default(0)
  totalDisputes      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listings              Listing[]
  bookings              Booking[] // брони, созданные пользователем как покупатель
  bookingEvents         BookingEvent[] // действия пользователя в журнале броней
  outboxOperations      OutboxOperation[] // идемпотентные операции (ADR-006)
  sessions              Session[] // сессии refresh-токенов (ADR-008)
  debtsAsCreditor       Debt[]                @relation("DebtCreditor") // долги, где я дал в долг
  debtsAsDebtor         Debt[]                @relation("DebtDebtor") // долги, где я должен
  debtEvents            DebtEvent[] // действия пользователя в журнале долгов
  notifications         Notification[] // in-app уведомления (v0.4.0)
  // Учёт часов 289-ФЗ (v0.4.0, ADR-011): пары «водитель — продавец».
  workSessionsAsDriver  WorkSession[]         @relation("WorkSessionDriver")
  workSessionsAsSeller  WorkSession[]         @relation("WorkSessionSeller")
  monthlyTotalsAsDriver MonthlyPairTotal[]    @relation("MonthlyPairDriver")
  monthlyTotalsAsSeller MonthlyPairTotal[]    @relation("MonthlyPairSeller")
  blockedPairsAsDriver  BlockedPair[]         @relation("BlockedPairDriver")
  blockedPairsAsSeller  BlockedPair[]         @relation("BlockedPairSeller")
  // Публичный рейтинг (v0.5.0, ADR-013).
  reputation            ReputationSnapshot? // один актуальный снимок (уникальный userId)
  reputationEvents      ReputationEvent[] // журнал изменений рейтинга (аудит)
  // Геозоны (v0.5.0, ADR-014): точки/линии/коридоры пользователя.
  geoPoints             GeoPoint[]
  // Доставка попутчиками (v0.5.0, ADR-015).
  deliveriesAsBuyer     DeliveryRequest[]     @relation("DeliveryBuyer")
  deliveriesAsDriver    DeliveryRequest[]     @relation("DeliveryDriver")
  deliveryEvents        DeliveryEvent[]
  // Push-уведомления (v0.6.0, ADR-031).
  deviceTokens          DeviceToken[]
  webPushSubscriptions  WebPushSubscription[]
  notificationLogs      NotificationLog[]
  // Арбитраж споров (v0.6.0-C, ADR-033).
  disputesAsFirstParty  DisputeCase[]         @relation("DisputeFirstParty")
  disputesAsSecondParty DisputeCase[]         @relation("DisputeSecondParty")
  disputesOpened        DisputeCase[]         @relation("DisputeOpenedBy")
  disputesAssigned      DisputeCase[]         @relation("DisputeAssignedTo")
  disputesResolved      DisputeCase[]         @relation("DisputeResolvedBy")
  disputeMessages       DisputeMessage[]
  disputeEvidence       DisputeEvidence[]
  // Апелляции на блокировки 289-ФЗ (v0.6.0-E, ADR-035 → v0.7.0-C, ADR-037).
  appealsAsDriver       AppealCase[]          @relation("AppealDriver")
  appealsAsSeller       AppealCase[]          @relation("AppealSeller")
  appealsAsAppellant    AppealCase[]          @relation("AppealAppellant")
  appealsAssigned       AppealCase[]          @relation("AppealAssignedTo")
  appealsResolved       AppealCase[]          @relation("AppealResolvedBy")
  appealMessages        AppealMessage[]
  blocksUnblocked       BlockedPair[]         @relation("BlockedPairUnblockedBy")

  @@map("users")
}

/// Аудит-запись «семьи» refresh-токенов (v0.3.1, ADR-008).
///
/// Одна строка = один вход (POST /auth/verify). При каждом refresh токен
/// ротируется: currentJti обновляется, старый jti уходит в usedJtis.
/// Повторное использование старого jti — признак кражи: вся семья
/// отзывается (revokedAt). Решения об авторизации принимает Redis
/// (session-store.ts) — таблица нужна для аудита, поддержки и очистки.
model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// UUID семьи: все ротации одного входа живут под одним familyId.
  familyId   String
  /// Актуальный jti refresh-токена (после последней ротации).
  currentJti String
  /// История ротаций — какие jti уже были использованы.
  usedJtis   String[]  @default([])
  /// Момент отзыва семьи (logout / обнаружение повторного использования).
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// User-Agent устройства — для экрана «активные сессии» в будущем.
  userAgent  String?
  /// IP устройства на момент входа.
  ip         String?

  @@unique([familyId])
  @@unique([currentJti])
  @@index([userId])
  @@index([familyId])
  @@index([currentJti])
  @@map("sessions")
}

model Listing {
  id                String          @id @default(uuid())
  sellerId          String
  seller            User            @relation(fields: [sellerId], references: [id])
  title             String
  category          ListingCategory
  unit              ListingUnit
  pricePerUnit      Decimal         @db.Decimal(10, 2)
  quantityAvailable Int
  quantityReserved  Int             @default(0)
  lineNumber        Int?
  isPerishable      Boolean         @default(false)
  status            ListingStatus   @default(active)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bookings Booking[]
  /// Долги, привязанные к лоту (если товар отпущен в долг, ADR-010).
  debts    Debt[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@map("listings")
}

model Booking {
  id                  String        @id @default(uuid())
  listingId           String
  listing             Listing       @relation(fields: [listingId], references: [id])
  buyerId             String
  buyer               User          @relation(fields: [buyerId], references: [id])
  requestedQuantity   Int
  confirmedQuantity   Int?
  status              BookingStatus @default(requested)
  /// TTL запроса: по истечении бронь гасится кроном, резерв возвращается листингу.
  expiresAt           DateTime
  /// Момент подтверждения брони продавцом (v0.4.0-C): якорь
  /// авто-подтверждения приёмки через BOOKING_AUTO_CONFIRM_HOURS.
  confirmedAt         DateTime?
  /// Момент подтверждения приёмки покупателем (confirm-delivery).
  deliveryConfirmedAt DateTime?
  /// Фактически полученное количество (≤ confirmedQuantity).
  receivedQuantity    Int?
  /// Комментарий качества при приёмке (опционально).
  qualityNotes        String?
  /// Оценка качества: ok / minor_issue / major_issue (ADR-012).
  qualityFlag         QualityFlag   @default(ok)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  events           BookingEvent[]
  /// Долги, привязанные к брони (если товар отпущен в долг по брони, ADR-010).
  debts            Debt[]
  /// Запросы доставки по брони (v0.5.0, ADR-015).
  deliveryRequests DeliveryRequest[]

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@map("bookings")
}

/// Append-only журнал изменений брони. Строки только добавляются,
/// никакие поля не обновляются и не удаляются — из журнала считается репутация.
model BookingEvent {
  id        String        @id @default(uuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Кто совершил действие. NULL — системные действия (истечение TTL по крону).
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id])
  action    BookingAction
  /// Дополнительно: содержимое корректировки, причина отмены и т.п.
  payload   Json?
  createdAt DateTime      @default(now())

  @@index([bookingId])
  @@index([actorId])
  @@map("booking_events")
}

/// Тип идемпотентной операции из мобильного outbox (ADR-006).
/// create_debt/confirm_delivery добавлены в v0.3.0 на будущее;
/// settle/dispute/resolve_debt — v0.4.0 (ADR-010).
enum OutboxOperationType {
  create_booking
  cancel_booking
  confirm_booking
  counter_offer_booking
  accept_counter_booking
  create_debt
  confirm_delivery
  settle_debt
  dispute_debt
  resolve_debt
  create_delivery
  assign_delivery
  start_delivery
  deliver_delivery
  cancel_delivery
  // v0.6.0-C (ADR-033): арбитраж споров.
  open_dispute
  dispute_message
  dispute_evidence
  assign_dispute
  resolve_dispute
  // v0.6.0-E (ADR-035): апелляции на блокировки 289-ФЗ.
  open_appeal
  assign_appeal
  resolve_appeal
  // v0.7.0-C (ADR-037): переписка в апелляциях.
  appeal_message
}

/// Состояние операции на сервере (ADR-006).
enum OutboxState {
  received
  processed
  failed
}

/// Серверная сторона идемпотентности: одна строка на X-Idempotency-Key.
///
/// Гарантия «ровно один раз» между клиентом и сервером: при повторном
/// запросе с тем же clientUuid сервер отвечает сохранённым результатом,
/// не выполняя операцию повторно. Строки не удаляются — это журнал того,
/// какие операции клиент уже провёл (пригодится и для поддержки).
model OutboxOperation {
  id            String              @id @default(uuid())
  /// UUID от клиента (X-Idempotency-Key). Уникален глобально.
  clientUuid    String              @unique
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  operationType OutboxOperationType
  /// Тело запроса как пришло — для разбора инцидентов.
  payload       Json
  /// Ответ обработчика ({status, body}) — проигрывается при повторе.
  result        Json?
  state         OutboxState         @default(received)
  createdAt     DateTime            @default(now())
  processedAt   DateTime?

  @@index([userId])
  @@map("outbox_operations")
}

/// Статус долга. Совпадает с DEBT_STATUSES из @agromoll/types.
/// cancelled — зарезервирован на будущее (аннулирование по согласию
/// сторон); в v0.4.0 перехода в cancelled ещё нет (ADR-010).
enum DebtStatus {
  active
  settled
  disputed
  cancelled
}

/// Действие из журнала долга. Совпадает с DEBT_ACTIONS из @agromoll/types.
enum DebtAction {
  created
  settled
  disputed
  cancelled
  reminder_sent
  resolve_requested
  resolve_confirmed
}

/// Долг — записанная договорённость «товар отпущен в долг» (v0.4.0, ADR-010).
///
/// Платформа НЕ является платёжным агентом: строки — только учёт
/// договорённости между двумя участниками рынка. Кредитор (creditor)
/// создал запись, дебитор (debtor) должен вернуть сумму. Каждый переход
/// статуса фиксируется в append-only журнале DebtEvent — из него в
/// будущем считается «надёжность оплаты» (репутация v0.5.0).
model Debt {
  id                 String     @id @default(uuid())
  /// Кто дал в долг (создал запись).
  creditorId         String
  creditor           User       @relation("DebtCreditor", fields: [creditorId], references: [id])
  /// Кто взял в долг.
  debtorId           String
  debtor             User       @relation("DebtDebtor", fields: [debtorId], references: [id])
  amount             Decimal    @db.Decimal(12, 2)
  /// Валюта. В MVP только RUB — защита от опечаток при вводе.
  currency           String     @default("RUB")
  description        String?
  /// Долг по конкретному лоту (опционально).
  listingId          String?
  listing            Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Долг по конкретной брони (опционально).
  bookingId          String?
  booking            Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status             DebtStatus @default(active)
  /// Обоюдное разрешение спора (ADR-010): кто из сторон ПЕРВЫМ нажал
  /// «Согласен» в статусе disputed. Второе подтверждение другой стороной
  /// закрывает спор — status → settled.
  resolveRequestedBy String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  /// Момент погашения (прямой settle или обоюдный resolve).
  settledAt          DateTime?

  events DebtEvent[]

  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([createdAt])
  @@map("debts")
}

/// Append-only журнал изменений долга. Строки только добавляются —
/// из журнала считается «надёжность оплаты» (репутация v0.5.0, ADR-010).
model DebtEvent {
  id        String     @id @default(uuid())
  debtId    String
  debt      Debt       @relation(fields: [debtId], references: [id], onDelete: Cascade)
  /// Кто совершил действие. NULL — системные действия (будущее).
  actorId   String?
  actor     User?      @relation(fields: [actorId], references: [id])
  action    DebtAction
  /// Дополнительно: причина спора, текст напоминания и т.п.
  payload   Json?
  createdAt DateTime   @default(now())

  @@index([debtId])
  @@index([actorId])
  @@map("debt_events")
}

/// Тип in-app уведомления. Совпадает с NOTIFICATION_TYPES из @agromoll/types.
/// v0.4.0-A: напоминание о долге; v0.4.0-C: события приёмки (ADR-012);
/// v0.6.0-A: события броней/доставок/репутации для push (ADR-031);
/// v0.6.0-C: события арбитража споров (ADR-033).
enum NotificationType {
  debt_reminder
  booking_delivery_confirmed
  booking_delivery_disputed
  booking_counter_offered
  booking_confirmed
  booking_cancelled
  delivery_assigned
  delivery_started
  delivery_delivered
  delivery_cancelled
  reputation_score_dropped
  dispute_opened
  dispute_message
  dispute_assigned
  dispute_resolved
  // v0.6.0-E (ADR-035): апелляции на блокировки 289-ФЗ.
  appeal_opened
  appeal_assigned
  appeal_resolved
  // v0.7.0-C (ADR-037): переписка в апелляциях.
  appeal_message
}

/// In-app уведомление (v0.4.0, ADR-010; push — v0.6.0, ADR-031).
///
/// Строка в БД — гарантированный «in-app» канал: читается
/// GET /notifications/me, прочитанные помечаются readAt. Push на
/// устройства (FCM/Web Push) — вспомогательный best-effort канал
/// поверх той же строки; журнал его доставок — NotificationLog.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// Контекст: id долга, сумма и т.п. — для перехода по тапу.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Платформа устройства для push (v0.6.0, ADR-031).
/// ios/android — Expo push/FCM; web — Web Push API (VAPID).
enum DevicePlatform {
  ios
  android
  web
}

/// Канал доставки push (v0.6.0, ADR-031).
enum NotificationChannel {
  fcm
  web_push
}

/// Статус доставки push для аудита (v0.6.0, ADR-031).
/// sent — провайдер принял; failed — 3 попытки не удались;
/// delivered — зарезервирован на будущее (receipt от клиента).
enum NotificationDeliveryStatus {
  sent
  failed
  delivered
}

/// Токен устройства для push (v0.6.0, ADR-031).
///
/// Один пользователь — много устройств (телефон + планшет + браузер).
/// Уникальность token: повторная регистрация того же токена (переустановка
/// приложения, другой аккаунт) — upsert: токен пере привязывается к
/// последнему пользователю. GIST-индексов не нужно — точечные выборки
/// по userId.
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FCM-токен устройства (Expo Push Token или нативный FCM-токен).
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  /// Последняя отправка на этот токен — для чистки неактивных.
  lastUsedAt DateTime?

  @@index([userId])
  @@map("device_tokens")
}

/// Подписка Web Push (v0.6.0, ADR-031).
///
/// Браузер отдаёт endpoint Push-сервиса + ключи шифрования aes128gcm.
/// Уникальность endpoint — как у DeviceToken: upsert при повторной
/// подписке. Отправка — web-push (VAPID), шифрование на стороне сервера.
model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL Push-сервиса браузера (уникален глобально).
  endpoint  String   @unique
  /// Клиентский открытый ключ (base64url, RFC 8291).
  p256dh    String
  /// Секрет аутентификации (base64url, RFC 8291).
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("web_push_subscriptions")
}

/// Журнал push-доставки для аудита (v0.6.0, ADR-031).
///
/// Каждая фактическая отправка (не событие, а именно доставка на токен)
/// фиксируется строкой: канал, статус, текст ошибки. In-app уведомления
/// сюда не пишутся — их «журнал» сама таблица notifications. Пользователь
/// видит только свои записи (GET /notifications/log — отладка «не пришло»).
model NotificationLog {
  id        String                     @id @default(uuid())
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationDeliveryStatus
  error     String?
  createdAt DateTime                   @default(now())

  @@index([userId, createdAt])
  @@map("notification_logs")
}

/// Рабочая сессия пары «водитель — продавец» (v0.4.0, ADR-011).
///
/// Юридическая страховка платформы (289-ФЗ): самозанятый водитель,
/// работающий 60+ часов в месяц с одним продавцом 6 месяцев подряд, —
/// признак трудовых отношений, а не самозанятости. Платформа считает
/// часы и требует паузу. Это НЕ биллинг и НЕ зарплата — только часы.
model WorkSession {
  id              String    @id @default(uuid())
  driverId        String
  driver          User      @relation("WorkSessionDriver", fields: [driverId], references: [id])
  sellerId        String
  seller          User      @relation("WorkSessionSeller", fields: [sellerId], references: [id])
  startedAt       DateTime  @default(now())
  /// Момент закрытия (подтверждение приёмки, отмена или ручное завершение).
  endedAt         DateTime?
  /// durationMinutes = endedAt − startedAt; NULL, пока сессия открыта.
  durationMinutes Int?
  /// Месяц старта «YYYY-MM» — денормализация для агрегации по парам.
  month           String
  createdAt       DateTime  @default(now())

  @@index([driverId, sellerId, month])
  @@index([month])
  @@map("work_sessions")
}

/// Помесячный итог пары «водитель — продавец» (v0.4.0, ADR-011).
///
/// Материализованный счётчик: инкремент при закрытии сессии.
/// monthCounted — засчитан ли месяц в «опасную» серию (≥ лимита часов);
/// при <60 ч в месяце серия сбрасывается (пересчёта истории нет).
model MonthlyPairTotal {
  id           String   @id @default(uuid())
  driverId     String
  driver       User     @relation("MonthlyPairDriver", fields: [driverId], references: [id])
  sellerId     String
  seller       User     @relation("MonthlyPairSeller", fields: [sellerId], references: [id])
  month        String
  totalMinutes Int      @default(0)
  /// ≥ WORK_HOURS_MONTHLY_LIMIT часов в этом месяце.
  monthCounted Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([driverId, sellerId, month])
  @@index([month])
  @@map("monthly_pair_totals")
}

/// Активная блокировка пары «водитель — продавец» (v0.4.0, ADR-011).
///
/// Создаётся кроном при 6 месяцах подряд с monthCounted=true:
/// 289-ФЗ требует паузу — новые сессии пары отклоняются (409).
/// Уникальный ключ — одна активная блокировка на пару.
model BlockedPair {
  id            String    @id @default(uuid())
  driverId      String
  driver        User      @relation("BlockedPairDriver", fields: [driverId], references: [id])
  sellerId      String
  seller        User      @relation("BlockedPairSeller", fields: [sellerId], references: [id])
  blockedAt     DateTime  @default(now())
  /// Причина — текст для мягкого экрана паузы в приложении.
  reason        String
  /// NULL — бессрочно (MVP: снятие блокировки — вручную поддержкой).
  unblockAt     DateTime?
  // v0.6.0-E (ADR-035): арбитражный разблок. Строка НЕ удаляется —
  // аудит «кто, когда и почему снял» остаётся навсегда. Активна
  // максимум одна блокировка на пару: частичный unique-индекс
  // (driverId, sellerId) WHERE "unblockedAt" IS NULL — в миграции.
  /// Когда блокировка снята арбитром. NULL — активна.
  unblockedAt   DateTime?
  /// Арбитр, снявший блокировку решением по апелляции.
  unblockedById String?
  unblockedBy   User?     @relation("BlockedPairUnblockedBy", fields: [unblockedById], references: [id])
  /// Обоснование разблока — публично для пары (notes апелляции).
  unblockReason String?
  createdAt     DateTime  @default(now())

  /// Апелляции на эту блокировку (активная — максимум одна, ADR-035).
  appeals AppealCase[]

  @@index([driverId, sellerId])
  @@map("blocked_pairs")
}

/// Актуальный снимок рейтинга пользователя (v0.5.0, ADR-013).
///
/// Материализованное представление журналов BookingEvent + DebtEvent:
/// пересчитывается триггерами (confirm-delivery, авто-подтверждение,
/// settle/dispute/resolve долга). score NULL — данных меньше
/// RATING_MIN_DEALS: новичков не наказываем отсутствием рейтинга,
/// API возвращает reason "min_deals_not_reached".
model ReputationSnapshot {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0–5, округление до 0.1. NULL — порог минимальных данных не достигнут.
  score              Float?
  dealsCount         Int      @default(0)
  disputesCount      Int      @default(0)
  autoConfirmedCount Int      @default(0)
  lastCalculatedAt   DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("reputation_snapshots")
}

/// Append-only журнал изменений рейтинга (v0.5.0, ADR-013).
///
/// Аудит «что случилось с рейтингом»: каждая строка — доменное событие
/// (сделка подтверждена, спор открыт, анти-накрутка сработала).
/// Источник правды для score — BookingEvent + DebtEvent (пересчёт
/// идемпотентен), этот журнал — человекочитаемая история для экрана
/// «Мой рейтинг». Строки не обновляются и не удаляются.
model ReputationEvent {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ReputationAction
  /// Вес события для рейтинга: +1.0 / +0.5 / +0.3 / −1.0 / 0 (нейтрально).
  delta     Float
  /// Контекст: «ok», «minor_issue», «debt_settled», «pair_deals_capped»…
  reason    String?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("reputation_events")
}

/// Геозона — точка на карте рынка (v0.5.0, подэтап B, ADR-014).
///
/// Единая модель для трёх видов: точки покупателей (куда везти),
/// линии продавцов (ряды рынка, откуда забирать) и коридоров
/// доставщиков (маршрут «еду туда — могу подвезти»). Координаты
/// хранятся и как Float-поля (доступны через Prisma-клиент), и как
/// PostGIS geography(Point, 4326) — синхронизируется триггером БД и
/// обслуживает пространственные запросы ST_DWithin/ST_Distance
/// с GIST-индексом (миграция 20261108100000_geo_points).
model GeoPoint {
  id             String                                @id @default(uuid())
  ownerId        String
  owner          User                                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind           GeoPointKind
  latitude       Float
  longitude      Float
  /// PostGIS geography(Point, 4326). Пишется триггером БД из
  /// (longitude, latitude); клиент работает только с lat/lng.
  geog           Unsupported("geography(Point,4326)")?
  address        String?
  label          String?
  radiusMeters   Int                                   @default(50)
  isActive       Boolean                               @default(true)
  /// Коридор (kind=delivery_corridor): точка старта {lat, lng}.
  corridorFrom   Json?
  /// Коридор: точка финиша {lat, lng}.
  corridorTo     Json?
  vehicleType    GeoVehicleType                        @default(car)
  maxWeightKg    Int?
  isRefrigerated Boolean                               @default(false)
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  /// Запросы доставки, где точка — место забора (v0.5.0, ADR-015).
  deliveryPickups  DeliveryRequest[] @relation("DeliveryPickup")
  /// Запросы доставки, где точка — место доставки (v0.5.0, ADR-015).
  deliveryDropoffs DeliveryRequest[] @relation("DeliveryDropoff")

  @@index([ownerId, kind])
  @@map("geo_points")
}

/// Запрос доставки попутчиком (v0.5.0, подэтап C, ADR-015).
///
/// Покупатель просит «подвезти от линии продавца к моей точке».
/// Платформа НЕ показывает цену и НЕ является агентом: водитель и
/// стороны договариваются сами (поля цены нет намеренно). Продавец
/// для пары 289-ФЗ (driver+seller) = владелец точки забора
/// (pickupPoint.owner) — смена начинается при взятии заказа.
/// pickupCode/dropoffCode — UUID для QR-подтверждения передачи.
model DeliveryRequest {
  id               String         @id @default(uuid())
  buyerId          String
  buyer            User           @relation("DeliveryBuyer", fields: [buyerId], references: [id])
  /// Доставка по конкретной брони (опционально).
  bookingId        String?
  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Откуда забрать: линия продавца (владелец точки = продавец).
  pickupPointId    String
  pickupPoint      GeoPoint       @relation("DeliveryPickup", fields: [pickupPointId], references: [id])
  /// Куда привезти: точка покупателя.
  dropoffPointId   String
  dropoffPoint     GeoPoint       @relation("DeliveryDropoff", fields: [dropoffPointId], references: [id])
  weightKg         Decimal        @db.Decimal(8, 2)
  description      String?
  status           DeliveryStatus @default(open)
  assignedDriverId String?
  assignedDriver   User?          @relation("DeliveryDriver", fields: [assignedDriverId], references: [id])
  assignedAt       DateTime?
  deliveredAt      DateTime?
  /// TTL запроса: по истечении крон переводит open → expired.
  expiresAt        DateTime
  /// QR-коды передачи (UUID, v0.5.0-C).
  pickupCode       String
  dropoffCode      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  events DeliveryEvent[]

  @@index([buyerId, status])
  @@index([assignedDriverId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("delivery_requests")
}

/// Append-only журнал доставки (v0.5.0, ADR-015).
/// Каждый переход статуса + попытки блокировки 289-ФЗ.
model DeliveryEvent {
  id         String              @id @default(uuid())
  deliveryId String
  delivery   DeliveryRequest     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  /// Кто совершил действие. NULL — системные (TTL-крон).
  actorId    String?
  actor      User?               @relation(fields: [actorId], references: [id])
  action     DeliveryEventAction
  payload    Json?
  createdAt  DateTime            @default(now())

  @@index([deliveryId])
  @@map("delivery_events")
}

// ─── Арбитраж споров (v0.6.0-C, ADR-033) ───────────────────────────────

/// Тип спорного объекта: бронь, доставка или долг.
enum DisputeType {
  booking
  delivery
  debt
}

/// Жизненный цикл спора: open → under_review → resolved | dismissed.
enum DisputeStatus {
  open
  under_review
  resolved
  dismissed
}

/// Решение арбитра (ADR-033):
///  - favor_buyer  — прав покупатель: штраф продавцу −1.0;
///  - favor_seller — прав продавец: штраф покупателю −1.0;
///  - compromise   — компромисс: обеим сторонам по −0.5;
///  - no_fault     — вины нет: рейтинг не трогаем.
/// «Покупатель/продавец» — роль стороны в спорной сделке, а не роль
/// в системе: в споре по долгу «покупатель» = дебитор, «продавец» =
/// кредитор; в споре по доставке «продавец» = доставщик.
enum DisputeResolution {
  favor_buyer
  favor_seller
  compromise
  no_fault
}

/// Спор (кейс арбитража, v0.6.0-C, ADR-033).
///
/// Одна строка = один кейс по объекту (брони/доставке/долгу).
/// Стороны фиксируются при открытии и не меняются:
///  - firstParty — «покупательская» сторона (buyer/debtor);
///  - secondParty — «продавецкая» сторона (seller/creditor/driver).
/// Ключевой инвариант: не более одного АКТИВНОГО (open/under_review)
/// спора на объект — частичный unique-индекс в миграции; повторное
/// открытие активного спора → 409 на уровне сервиса.
///
/// Пока спор активен, объект «заморожен»: бизнес-переходы брони/долга/
/// доставки возвращают 409 (кроме чтения) — стороны выясняют отношения
/// в арбитраже, а не меняют предмет спора у себя под ногами.
model DisputeCase {
  id            String             @id @default(uuid())
  /// Тип и id спорного объекта (бронь/доставка/долг).
  type          DisputeType
  referenceId   String
  /// «Покупательская» сторона, зафиксирована при открытии.
  firstPartyId  String
  firstParty    User               @relation("DisputeFirstParty", fields: [firstPartyId], references: [id])
  /// «Продавецкая» сторона, зафиксирована при открытии.
  secondPartyId String
  secondParty   User               @relation("DisputeSecondParty", fields: [secondPartyId], references: [id])
  /// Кто открыл спор (одна из сторон).
  openedById    String
  openedBy      User               @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  openedAt      DateTime           @default(now())
  status        DisputeStatus      @default(open)
  /// Арбитр, взявший спор в работу (стадия under_review).
  assignedToId  String?
  assignedTo    User?              @relation("DisputeAssignedTo", fields: [assignedToId], references: [id])
  assignedAt    DateTime?
  /// Решение + кто/когда закрыл (только для resolved/dismissed).
  resolution    DisputeResolution?
  resolvedById  String?
  resolvedBy    User?              @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  /// Обоснование решения арбитра (публично для сторон).
  notes         String?
  /// Краткое описание предмета спора (для списка/очереди).
  subject       String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages DisputeMessage[]
  evidence DisputeEvidence[]

  @@index([status, openedAt])
  @@index([firstPartyId])
  @@index([secondPartyId])
  @@index([type, referenceId])
  @@map("dispute_cases")
}

/// Сообщение в споре (append-only, v0.6.0-C, ADR-033).
///
/// Переговоры сторон и арбитра: строки только добавляются, ничего не
/// редактируется и не удаляется. isInternal — служебные заметки арбитра:
/// видит только роль arbitrator, сторонам не показываются (DTO-фильтр).
model DisputeMessage {
  id         String      @id @default(uuid())
  disputeId  String
  dispute    DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id])
  body       String
  /// Служебная заметка арбитра — скрыта от сторон (ADR-033).
  isInternal Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

/// Доказательство в споре (v0.6.0-C → v0.7.0-B, ADR-036).
///
/// Файл хранится в S3-совместимом хранилище (presigned PUT напрямую с
/// клиента — трафик не проходит через API), в БД — только ссылка и
/// метаданные.
/// fileUrl — две формы:
///   s3://<objectKey>    — объект в хранилище (ключ без имени бакета:
///                         бакет задаётся конфигом, переименование не
///                         ломает строки);
///   data:<mime>;base64… — резервный путь (fallback) для критических
///                         случаев, когда хранилище недоступно; лимит
///                         500 КБ, проверяется zod-схемой на входе.
/// createdAt и есть момент загрузки (подтверждения) — отдельной
/// колонки uploadedAt не заводим, дублирование бесполезно.
model DisputeEvidence {
  id           String      @id @default(uuid())
  disputeId    String
  dispute      DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Ссылка на файл: s3://<objectKey> или data:<mime>;base64 (fallback).
  fileUrl      String      @db.Text
  createdAt    DateTime    @default(now())

  @@index([disputeId])
  @@map("dispute_evidence")
}

/// Жизненный цикл апелляции (v0.6.0-E, ADR-035):
/// open → under_review → unblocked | rejected.
/// Терминальные статусы — они же суть решения арбитра.
enum AppealStatus {
  open
  under_review
  /// Блокировка снята арбитром — пара может работать.
  unblocked
  /// Апелляция отклонена — блокировка остаётся.
  rejected
}

/// Апелляция на блокировку 289-ФЗ (v0.6.0-E, ADR-035).
///
/// Обжалование АКТИВНОЙ блокировки пары водитель–продавец:
/// подаёт любая сторона пары (обе страдают от паузы), рассматривает
/// арбитр. Один АКТИВНЫЙ кейс на блокировку — частичный unique-индекс
/// (blockedPairId) WHERE status IN ('open','under_review') в миграции;
/// после закрытия подать снова можно (например, с новыми данными).
///
/// Пара дублируется полями driverId/sellerId: блокировка может быть
/// снята, кейс — нет; история обжалований не теряет предмет.
/// Переписки и файлов в MVP нет: суть — reason, доказательство —
/// сама история часов пары (отдаётся в деталях кейса).
model AppealCase {
  id            String       @id @default(uuid())
  /// Блокировка, на которую подана апелляция (активная).
  blockedPairId String
  blockedPair   BlockedPair  @relation(fields: [blockedPairId], references: [id])
  /// Пара — «предмет» кейса, фиксируется при открытии.
  driverId      String
  driver        User         @relation("AppealDriver", fields: [driverId], references: [id])
  sellerId      String
  seller        User         @relation("AppealSeller", fields: [sellerId], references: [id])
  /// Кто подал (водитель ИЛИ продавец пары).
  appellantId   String
  appellant     User         @relation("AppealAppellant", fields: [appellantId], references: [id])
  openedAt      DateTime     @default(now())
  /// Почему блокировка ошибочна (текст жалобы).
  reason        String
  status        AppealStatus @default(open)
  /// Арбитр, взявший кейс в работу (стадия under_review).
  assignedToId  String?
  assignedTo    User?        @relation("AppealAssignedTo", fields: [assignedToId], references: [id])
  assignedAt    DateTime?
  /// Кто/когда закрыл кейс (только для unblocked/rejected).
  resolvedById  String?
  resolvedBy    User?        @relation("AppealResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  /// Обоснование решения — публично для пары.
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Переписка кейса (append-only, ADR-037).
  messages      AppealMessage[]

  @@index([status, openedAt])
  @@index([driverId, sellerId])
  @@map("appeal_cases")
}

/// Сообщение в переписке апелляции (v0.7.0-C, ADR-037).
///
/// Зеркалит DisputeMessage: append-only (правка/удаление запрещены —
/// журнал разбирательства), isInternal — служебные заметки, видит
/// только арбитр. Автор — сторона пары или арбитр; посторонние в кейс
/// не попадают (проверка в сервисе).
model AppealMessage {
  id         String     @id @default(uuid())
  appealId   String
  appeal     AppealCase @relation(fields: [appealId], references: [id], onDelete: Cascade)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id])
  body       String
  /// Служебная заметка арбитра — скрыта от сторон пары (ADR-037).
  isInternal Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([appealId, createdAt])
  @@map("appeal_messages")
}
