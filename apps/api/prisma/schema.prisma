// АгроМолл — базовая схема.
// Этап «фундамент»: только User с ролью. Бизнес-модели (брони, заказы, долги,
// геозоны, смены) появятся на следующих этапах — см. docs/adr/ADR-001.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Роль участника рынка. Совпадает с USER_ROLES из @agromoll/types
/// и UserRoleSchema из @agromoll/validation.
enum UserRole {
  buyer
  seller
  driver
}

model User {
  id        String   @id @default(uuid())
  role      UserRole @default(buyer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
