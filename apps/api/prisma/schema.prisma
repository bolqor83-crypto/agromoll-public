// Prisma-схема АгроМолл.
//
// Этап 1 (каркас): только базовая модель пользователя с ролью.
// Бизнес-модели (заявки, брони, долги, доставки, геозоны) — следующие этапы.
// Расширение PostGIS для геоданных закладывается в первой миграции
// (prisma/migrations/..._init/migration.sql) — см. ADR-001.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Роли участников рынка. Согласовано с @agromoll/types (packages/types/src/index.ts).
enum Role {
  BUYER
  SELLER
  DRIVER
}

/// Участник рынка. Аутентификация — следующий этап, поэтому поля phone/name опциональны.
model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  name      String?
  role      Role     @default(BUYER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
