{
  "name": "@agromoll/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Мобильное приложение АгроМолл: покупатель, продавец, доставщик. Этап 1 — каркас и дизайн-система.",
