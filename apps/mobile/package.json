{
  "name": "@agromoll/mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Мобильное приложение АгроМолл (Expo Router). Этап «фундамент»: экраны-заглушки.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build": "expo export --platform web --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@agromoll/ui": "workspace:*",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.8",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-status-bar": "~2.0.1",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.7.2"
  }
}
