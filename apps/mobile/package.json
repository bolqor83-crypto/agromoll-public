{
  "name": "@agromoll/mobile",
  "version": "0.8.1",
  "private": true,
  "description": "Мобильное приложение АгроМолл (Expo Router). Этап «фундамент»: экраны-заглушки.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
