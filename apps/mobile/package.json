    "eslint": "^9.17.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.7.2"
