// Expo подставляет EXPO_PUBLIC_* переменные в код приложения на СБОРКЕ
// (Metro инлайнит их в бандл; на Vercel окружение каждой сборки чистое).

// ─── API (v0.6.1-0, ADR-022) ────────────────────────────────────────────────
// Адрес API-сервера. В dev без переменной — фолбэк http://localhost:3000;
// в prod не задан → экран «Сервер не настроен» (без молчаливых localhost).
EXPO_PUBLIC_API_URL=http://localhost:3000

// ─── Тайлы карты (v0.7.0-E, ADR-039) ────────────────────────────────────────
// По умолчанию (пусто) — OpenStreetMap: без ключей, fair use для MVP.
// При росте трафика подключите платного провайдера — меняется только
// переменная сборки, не код. Шаблон обязан содержать {z}/{x}/{y}:
// EXPO_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=ВАШ_КЛЮЧ
EXPO_PUBLIC_MAP_TILES_URL=

// Атрибуция — требование лицензии провайдера (HTML разрешён).
// Не задана → честное «© <host провайдера>»: забыть атрибуцию конфиг
// не позволяет. Примеры: MapTiler — «© OpenStreetMap contributors © MapTiler»,
// Mapbox — «© Mapbox», Thunderforest — «© OpenStreetMap contributors © Thunderforest».
EXPO_PUBLIC_MAP_TILES_ATTRIBUTION=

// Максимальный зум провайдера (12..22). По умолчанию 19 (контракт ADR-034).
EXPO_PUBLIC_MAP_TILES_MAX_ZOOM=
