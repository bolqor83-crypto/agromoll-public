{
  "name": "agromoll",
  "version": "0.6.2",
  "private": true,
  "description": "АгроМолл — оптово-розничный рынок Ростова-на-Дону. Каркас мобильного приложения, дизайн-система и API.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @agromoll/api exec prisma migrate deploy",
    "db:studio": "pnpm --filter @agromoll/api exec prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
