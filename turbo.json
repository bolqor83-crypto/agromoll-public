{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.spec.ts"],
      "outputs": ["dist/**"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_MAP_TILES_URL",
        "EXPO_PUBLIC_MAP_TILES_ATTRIBUTION",
        "EXPO_PUBLIC_MAP_TILES_MAX_ZOOM"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
