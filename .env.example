# --- API (apps/api читает эти переменные) ---
API_PORT=3000
LOG_LEVEL=info
# Совпадает с docker-compose.yml
DATABASE_URL=postgresql://agromoll:agromoll@localhost:5432/agromoll?schema=public
REDIS_URL=redis://localhost:6379
# TTL запроса брони в минутах: по истечении бронь гасится, резерв возвращается
BOOKING_TTL_MINUTES=30

# --- Auth (ADR-007/008). В production секреты ОБЯЗАТЕЛЬНЫ (старт упадёт без них) ---
# Секреты для подписи JWT (длинные случайные строки; dev-дефолты — только локально)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# TTL токенов (ротация: refresh возвращает новую пару, v0.3.1)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Mobile (Expo подставляет EXPO_PUBLIC_* в приложение) ---
# Базовый URL API. В dev без переменной — фолбэк http://localhost:3000.
# В prod (сборка web/native) фолбэка НЕТ: без переменной приложение
# покажет экран «Сервер не настроен» (ADR-022). Адрес вшивается в бандл
# на момент сборки — для Vercel задайте его в Project Settings →
# Environment Variables и пересоберите деплой (см. docs/DEPLOY.md).
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- GitHub (для локальных скриптов публикации; НИКОГДА не коммитить) ---
GITHUB_TOKEN=

# --- Долги (v0.4.0, ADR-010) ---
# Кулдаун напоминаний о долге в часах (не чаще одного раза в сутки на долг)
DEBT_REMINDER_COOLDOWN_HOURS=24
# Ключ FCM сервера (legacy HTTP API). Пусто — push выключен, только in-app
FCM_SERVER_KEY=

# --- Учёт часов 289-ФЗ (v0.4.0, ADR-011) ---
# Лимит часов в месяц на пару «водитель — продавец» (порог трудовых отношений)
WORK_HOURS_MONTHLY_LIMIT=60
# Сколько месяцев подряд с ≥лимитом до блокировки пары
WORK_MONTHS_SERIES=6

# --- Приёмка (v0.4.0, ADR-012) ---
# Окно авто-подтверждения приёмки в часах (после подтверждения брони продавцом)
BOOKING_AUTO_CONFIRM_HOURS=24

# --- Публичный рейтинг (v0.5.0, ADR-013) ---
# Минимум учтённых событий для появления score (меньше — score=null, новичков не наказываем)
RATING_MIN_DEALS=5
# Анти-накрутка: сделок пары «покупатель — продавец» в окне, выше — вес 0.3
RATING_MAX_PAIR_DEALS=10
# Окно анти-накрутки в днях
RATING_PAIR_WINDOW_DAYS=30
# Веса событий (значения по умолчанию — спецификация v0.5.0-A)
RATING_WEIGHT_OK=1.0
RATING_WEIGHT_MINOR=0.5
RATING_WEIGHT_AUTO=0.3
RATING_WEIGHT_DISPUTE=1.0
RATING_PAIR_CAP_WEIGHT=0.3

# --- Геозоны (v0.5.0, ADR-014) ---
# Радиус поиска «рядом» по умолчанию в метрах (фильтр ленты, карта)
DEFAULT_GEO_RADIUS_METERS=2000

# --- Доставка попутчиками (v0.5.0, ADR-015) ---
# TTL открытого запроса доставки в минутах (крон гасит просроченные)
DELIVERY_TTL_MINUTES=60
