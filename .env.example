# --- API (apps/api читает эти переменные) ---
API_PORT=3000
LOG_LEVEL=info
# Совпадает с docker-compose.yml
DATABASE_URL=postgresql://agromoll:agromoll@localhost:5432/agromoll?schema=public
REDIS_URL=redis://localhost:6379
# TTL запроса брони в минутах: по истечении бронь гасится, резерв возвращается
BOOKING_TTL_MINUTES=30

# --- Auth (ADR-007/008). В production секреты ОБЯЗАТЕЛЬНЫ (старт упадёт без них) ---
# Секреты для подписи JWT (длинные случайные строки; dev-дефолты — только локально)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# TTL токенов (ротация: refresh возвращает новую пару, v0.3.1)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Mobile (Expo подставляет EXPO_PUBLIC_* в приложение) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- GitHub (для локальных скриптов публикации; НИКОГДА не коммитить) ---
GITHUB_TOKEN=

# --- Долги (v0.4.0, ADR-010) ---
# Кулдаун напоминаний о долге в часах (не чаще одного раза в сутки на долг)
DEBT_REMINDER_COOLDOWN_HOURS=24
# Ключ FCM сервера (legacy HTTP API). Пусто — push выключен, только in-app
FCM_SERVER_KEY=
