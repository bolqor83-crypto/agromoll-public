# --- Инфраструктура (docker-compose) ---
POSTGRES_USER=agromoll
POSTGRES_PASSWORD=agromoll
POSTGRES_DB=agromoll

# --- API (apps/api читает корневой .env через ConfigModule) ---
DATABASE_URL=postgresql://agromoll:agromoll@localhost:5432/agromoll?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
LOG_LEVEL=debug

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Секреты для ЛОКАЛЬНЫХ скриптов публикации. НЕ коммитить (файл .env в .gitignore) ---
# GITHUB_TOKEN=
